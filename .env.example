# 스텔라이즈팀 담당자가 /signup 의 가입 코드 칸에 넣는 코드. 팀 안에서만 공유한다. 비워 두면 담당자 가입이 막힌다.
STAFF_JOIN_CODE=
# 계약서 앱을 다른 주소로 띄울 때만.
# NEXT_PUBLIC_CONTRACT_APP_URL=http://localhost:8501
# 개발자 계정용 코드. /signup 의 가입 코드 칸에 넣으면 담당자 화면 전부와 크리에이터 화면 미리보기(보기 전용)를 쓴다. 비워 두면 개발자 가입이 막힌다.
DEV_JOIN_CODE=
# 자료를 Supabase에 저장할 때만. 둘 다 비워 두면 이 컴퓨터의 data/hub.json 파일에 저장한다.
# 표는 supabase/schema.sql 을 Supabase SQL Editor 에서 한 번 실행해 만든다.
# SECRET_KEY 는 Supabase → Project Settings → API Keys 의 secret 키(sb_secret_… 또는 예전 service_role). 절대 공개하지 않는다.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 마감 알림 메일을 보낼 때만. 비워 두면 화면 알림만 뜬다. README "마감 알림 메일" 참고.
# RESEND_API_KEY 는 resend.com 의 API 키. MAIL_FROM 의 도메인은 Resend 에 등록돼 있어야 한다.
RESEND_API_KEY=
MAIL_FROM=
# 모든 알림 메일에 참조로 들어갈 팀 메일. 여러 개면 쉼표로 구분.
MAIL_CC=
# 메일 본문에 넣을 허브 주소 (예: https://hub.example.com). 비우면 주소 없이 보낸다.
HUB_URL=
